# Copy to .env.local and fill in. Never commit real values.
ANTHROPIC_API_KEY=
# Model used by server-side AI routes
ANTHROPIC_MODEL=claude-sonnet-5-5

# Auth0 (@auth0/nextjs-auth0 4.33.0; names verified against its README in #7). Regular Web Application.
# Allowed Callback URLs: http://localhost:3000/auth/callback, https://hackpsu-f26.vercel.app/auth/callback
# Allowed Logout URLs + Allowed Web Origins: http://localhost:3000, https://hackpsu-f26.vercel.app
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex secret: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Optional: faster model for /api/profile (defaults to claude-haiku-5-5)
ANTHROPIC_PROFILE_MODEL=claude-haiku-5-5

# Emergency demo switch, leave unset. AI_DISABLED=1 makes every AI route use its template fallback.
AI_DISABLED=
# Emergency demo switch, leave unset. DEMO_AUTH_BYPASS=1 skips Auth0 checks (server-only; never NEXT_PUBLIC_).
DEMO_AUTH_BYPASS=
