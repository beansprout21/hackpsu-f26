# Copy to .env.local and fill in. Never commit real values.
ANTHROPIC_API_KEY=
# Model used by server-side AI routes
ANTHROPIC_MODEL=claude-sonnet-5-5

# Auth0 (@auth0/nextjs-auth0 v4 naming; verify against the SDK README during issue #7)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex secret: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Optional: faster model for /api/profile (defaults to claude-haiku-5-5)
ANTHROPIC_PROFILE_MODEL=claude-haiku-5-5
