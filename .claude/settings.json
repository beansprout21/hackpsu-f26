{
  "permissions": {
    "allow": [
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh label list*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git pull --rebase*)",
      "Bash(git checkout*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git rebase origin/main*)",
      "Bash(git push -u origin HEAD*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm run dev*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard*)",
      "Read(.env.local)",
      "Read(.env)"
    ]
  }
}
